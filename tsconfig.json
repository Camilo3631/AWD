{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "~/*": ["./src/*"] 
    },
    "types": ["nuxt", "node", "vitest/globals"]  // ✅ para no importar defineNuxtConfig
  },
  "include": [
    "nuxt.config.ts",
    "src",
    "test",
    "vitest.config.ts",
    "vue-shims.d.ts",
    ".nuxt/types/**/*.ts"
  ]
}