(globalThis.rspackChunk_figma_web_bundler=globalThis.rspackChunk_figma_web_bundler||[]).push([[8528],{39904(e,t,n){n.r(t),n.d(t,{_content:()=>eG,blockquote:()=>S,code:()=>g,codeHighlightAttribute:()=>v,codeHighlightClassName:()=>T,codeHighlightComment:()=>h,codeHighlightDeleted:()=>E,codeHighlightFunction:()=>k,codeHighlightInserted:()=>_,codeHighlightKeyword:()=>p,codeHighlightProperty:()=>x,codeHighlightPunctuation:()=>C,codeHighlightString:()=>m,codeHighlightTag:()=>y,codeHighlightValue:()=>b,codeHighlightVariable:()=>w,collapsibleHeadingRegionControl:()=>f,collapsibleHeadingRegionOverlay:()=>d,contentEditable:()=>r,h1:()=>i,h2:()=>o,h3:()=>a,h4:()=>s,h5:()=>u,h6:()=>c,hr:()=>el,hrSelected:()=>ei,hrWrapper:()=>er,imageAltEditor:()=>eE,imageFigure:()=>ea,imageFrame:()=>ef,imageFrameDraggable:()=>eb,imageFrameDragging:()=>ek,imageIcon:()=>eA,imageImg:()=>es,imageImgLetterboxed:()=>eu,imageImgPending:()=>ec,imageLightboxBackdrop:()=>eL,imageLightboxBackdropButton:()=>eR,imageLightboxCloseButton:()=>eM,imageLightboxImage:()=>eO,imageLightboxImageZoomButton:()=>eN,imageLightboxImageZoomButtonZoomed:()=>eB,imagePlaceholder:()=>eI,imagePlaceholderActionable:()=>eS,imageReorderDropIndicator:()=>ey,imageReplaceButton:()=>em,imageReplaceIcon:()=>ex,imageResizeHandle:()=>ev,imageResizeHandleNe:()=>ew,imageResizeHandleNw:()=>eT,imageResizeHandleSe:()=>e_,imageResizeHandleSw:()=>eC,imageSelected:()=>ed,imageStatusOverlay:()=>eg,imageStatusOverlayError:()=>eh,imageUploadingIndicator:()=>ep,imageWrapper:()=>eo,link:()=>eD,listItem:()=>A,listItemContent:()=>L,listItemMarker:()=>R,listItemMarkerGlyph:()=>N,listItemMarkerOrdered:()=>B,listItemMarkerTodo:()=>G,listItemMarkerTodoBox:()=>P,listItemMarkerTodoChecked:()=>K,listItemMarkerUnorderedCircle:()=>M,listItemMarkerUnorderedDisc:()=>O,listItemMarkerUnorderedSquare:()=>D,listItemTodoChecked:()=>H,paragraph:()=>l,quote:()=>I,table:()=>q,tableAddButton:()=>J,tableCell:()=>U,tableCellListContent:()=>$,tableCellSelected:()=>z,tableContextMenu:()=>Y,tableContextMenuItem:()=>V,tableContextMenuSeparator:()=>X,tableOverlay:()=>W,tableScrollContainer:()=>j,tableSelectButton:()=>Z,tableSelected:()=>F,textBold:()=>Q,textCode:()=>en,textItalic:()=>ee,textStrikethrough:()=>et});let r="figspec_editor_theme--contentEditable--nSwCZ",l="figspec_editor_theme--paragraph--x88eD",i="figspec_editor_theme--h1--hDr-E",o="figspec_editor_theme--h2--vd6Gw",a="figspec_editor_theme--h3--3--SB",s="figspec_editor_theme--h4--MgeBw",u="figspec_editor_theme--h5--Lpx0j",c="figspec_editor_theme--h6--i-AtS",d="figspec_editor_theme--collapsibleHeadingRegionOverlay--gTZxS",f="figspec_editor_theme--collapsibleHeadingRegionControl--VIya3",g="figspec_editor_theme--code--Ua5Hk",h="figspec_editor_theme--codeHighlightComment--MraHW",p="figspec_editor_theme--codeHighlightKeyword--TODYU",m="figspec_editor_theme--codeHighlightString--o-eZH",x="figspec_editor_theme--codeHighlightProperty--yQ1xF",b="figspec_editor_theme--codeHighlightValue--rBh6h",k="figspec_editor_theme--codeHighlightFunction--Jey22",y="figspec_editor_theme--codeHighlightTag--QAOjx",v="figspec_editor_theme--codeHighlightAttribute--UoELa",T="figspec_editor_theme--codeHighlightClassName--FnvFx",w="figspec_editor_theme--codeHighlightVariable--Yy51r",C="figspec_editor_theme--codeHighlightPunctuation--SkEyv",_="figspec_editor_theme--codeHighlightInserted--7CUUg",E="figspec_editor_theme--codeHighlightDeleted--r4IGI",I="figspec_editor_theme--quote--kU6ij",S="figspec_editor_theme--blockquote---jyjg",A="figspec_editor_theme--listItem--N5L4O",L="figspec_editor_theme--listItemContent--vdc6o",R="figspec_editor_theme--listItemMarker--RjVy0",N="figspec_editor_theme--listItemMarkerGlyph--rY-bb",B="figspec_editor_theme--listItemMarkerOrdered--lOZZl",O="figspec_editor_theme--listItemMarkerUnorderedDisc--IJ8z5",M="figspec_editor_theme--listItemMarkerUnorderedCircle--sYeyK",D="figspec_editor_theme--listItemMarkerUnorderedSquare--SEQmP",G="figspec_editor_theme--listItemMarkerTodo--uL4zq",P="figspec_editor_theme--listItemMarkerTodoBox--RwRy3",K="figspec_editor_theme--listItemMarkerTodoChecked--pH6hP",H="figspec_editor_theme--listItemTodoChecked--luzox",j="figspec_editor_theme--tableScrollContainer--W-mSQ",F="figspec_editor_theme--tableSelected--260Bm",z="figspec_editor_theme--tableCellSelected---gaJG",q="figspec_editor_theme--table--w42w-",U="figspec_editor_theme--tableCell--kOUIy",$="figspec_editor_theme--tableCellListContent--5v-7T",W="figspec_editor_theme--tableOverlay--asZRl",J="figspec_editor_theme--tableAddButton--Gqqyj",Z="figspec_editor_theme--tableSelectButton--ENcLM",Y="figspec_editor_theme--tableContextMenu--NDXBp",V="figspec_editor_theme--tableContextMenuItem--eECWj",X="figspec_editor_theme--tableContextMenuSeparator--CUqyl",Q="figspec_editor_theme--textBold--GAzpA",ee="figspec_editor_theme--textItalic--s7kEe",et="figspec_editor_theme--textStrikethrough--clr5V",en="figspec_editor_theme--textCode--DrCvh",er="figspec_editor_theme--hrWrapper--Duo9D",el="figspec_editor_theme--hr--Pfjmj",ei="figspec_editor_theme--hrSelected--VF7R0",eo="figspec_editor_theme--imageWrapper--AtJvo",ea="figspec_editor_theme--imageFigure--hSA0Z",es="figspec_editor_theme--imageImg--rxosR",eu="figspec_editor_theme--imageImgLetterboxed--8w0aE",ec="figspec_editor_theme--imageImgPending--UGV2w",ed="figspec_editor_theme--imageSelected--ZlW-h",ef="figspec_editor_theme--imageFrame--TTlDx",eg="figspec_editor_theme--imageStatusOverlay--tttfR",eh="figspec_editor_theme--imageStatusOverlayError--m4Br2",ep="figspec_editor_theme--imageUploadingIndicator--O3cH9",em="figspec_editor_theme--imageReplaceButton--q7zQJ",ex="figspec_editor_theme--imageReplaceIcon--7h-UW",eb="figspec_editor_theme--imageFrameDraggable--UUV5b",ek="figspec_editor_theme--imageFrameDragging--SuA-D",ey="figspec_editor_theme--imageReorderDropIndicator--lF7OT",ev="figspec_editor_theme--imageResizeHandle--1T0F5",eT="figspec_editor_theme--imageResizeHandleNw--1UZDv",ew="figspec_editor_theme--imageResizeHandleNe--KIJNf",eC="figspec_editor_theme--imageResizeHandleSw--xhw80",e_="figspec_editor_theme--imageResizeHandleSe--c72x0",eE="figspec_editor_theme--imageAltEditor--gv1xX",eI="figspec_editor_theme--imagePlaceholder--8cHKO",eS="figspec_editor_theme--imagePlaceholderActionable--ZXL04",eA="figspec_editor_theme--imageIcon--t-fas",eL="figspec_editor_theme--imageLightboxBackdrop--9QYOq",eR="figspec_editor_theme--imageLightboxBackdropButton--l1bPE",eN="figspec_editor_theme--imageLightboxImageZoomButton--zTllM",eB="figspec_editor_theme--imageLightboxImageZoomButtonZoomed--Zbbo8",eO="figspec_editor_theme--imageLightboxImage--noLBW",eM="figspec_editor_theme--imageLightboxCloseButton--d2Ag7",eD="figspec_editor_theme--link--omn0r",eG="/** @postcss-export-raw */\n\n/* Content editable root \u2014 disable Lexical's built-in indent rendering\n   (padding-inline-start). Indent is handled by custom list item presentation CSS. */\n\n.figspec_editor_theme--contentEditable--nSwCZ {\n  --figspec-heading-control-gutter: 32px;\n  --lexical-indent-base-value: 0px;\n  overflow-x: visible;\n}\n\n/* Paragraphs */\n\n.figspec_editor_theme--paragraph--x88eD {\n  margin: 0 0 var(--spacer-2, 8px) 0;\n  line-height: 1.6;\n}\n\n/* Headings */\n\n.figspec_editor_theme--h1--hDr-E {\n  font-size: 32px;\n  font-weight: 700;\n  line-height: 1.25;\n  margin: var(--spacer-5, 32px) 0 var(--spacer-3, 16px) 0;\n  color: var(--color-text, #1a1a1a);\n  letter-spacing: -0.02em;\n}\n\n.figspec_editor_theme--h1--hDr-E:first-child {\n  margin-top: 0;\n}\n\n.figspec_editor_theme--h2--vd6Gw {\n  font-size: 24px;\n  font-weight: 700;\n  line-height: 1.3;\n  margin: 28px 0 var(--spacer-2-5, 12px) 0;\n  color: var(--color-text, #1a1a1a);\n  letter-spacing: -0.01em;\n}\n\n.figspec_editor_theme--h3--3--SB {\n  font-size: 20px;\n  font-weight: 600;\n  line-height: 1.35;\n  margin: var(--spacer-4, 24px) 0 10px 0;\n  color: var(--color-text, #1a1a1a);\n}\n\n.figspec_editor_theme--h4--MgeBw {\n  font-size: 18px;\n  font-weight: 600;\n  line-height: 1.4;\n  margin: 20px 0 var(--spacer-2, 8px) 0;\n  color: var(--color-text, #1a1a1a);\n}\n\n.figspec_editor_theme--h5--Lpx0j {\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.45;\n  margin: var(--spacer-3, 16px) 0 6px 0;\n  color: var(--color-text-secondary, #666);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.figspec_editor_theme--h6--i-AtS {\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.5;\n  margin: var(--spacer-2-5, 12px) 0 var(--spacer-1, 4px) 0;\n  color: var(--color-text-tertiary, #999);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.figspec_editor_theme--h1--hDr-E,\n.figspec_editor_theme--h2--vd6Gw,\n.figspec_editor_theme--h3--3--SB,\n.figspec_editor_theme--h4--MgeBw,\n.figspec_editor_theme--h5--Lpx0j,\n.figspec_editor_theme--h6--i-AtS {\n  position: relative;\n  box-sizing: border-box;\n  margin-left: calc(var(--figspec-heading-control-gutter) * -1);\n  padding-left: var(--figspec-heading-control-gutter);\n}\n\n/* Heading placeholders (Notion-style ghost text).\n   Set by `heading_placeholder_plugin.tsx` as `data-figspec-placeholder=\"...\"`\n   on HeadingNode DOM elements. The ::before renders inside the heading, so it\n   inherits the heading's font metrics and stays aligned with the caret even\n   when the tag changes (e.g. user types `## ` to convert H1 -> H2).\n   Matches both `:empty` and the `<br>` Lexical inserts as a caret anchor.\n   The attribute name is figspec-specific so a stray `data-placeholder`\n   elsewhere in the editor DOM doesn't pick up ghost-text styling.\n\n   The ::before MUST be position: absolute. The caret sits at offset 0 of the\n   heading (either in the :empty element or just before the <br>), but an\n   inline ::before would paint its content first and visually push the caret\n   past the ghost text. Taking it out of flow lets the caret render at the\n   heading content edge, overlaying the start of the placeholder. */\n\n[data-figspec-placeholder] {\n  position: relative;\n}\n\n[data-figspec-placeholder]:empty::before,\n[data-figspec-placeholder]:has(> br:only-child)::before {\n  content: attr(data-figspec-placeholder);\n  position: absolute;\n  left: var(--figspec-heading-control-gutter, 0px);\n  top: 0;\n  color: var(--color-text-tertiary, #999);\n  pointer-events: none;\n  -webkit-user-select: none;\n          user-select: none;\n  white-space: nowrap;\n  /* H5/H6 set text-transform: uppercase and letter-spacing: 0.04em for their\n     uppercase label style. These inherit into ::before and would render the\n     ghost text as \"HEADING 5\" / \"HEADING 6\" with wide tracking, which\n     disagrees with the mixed-case dictionary strings. Reset both on the\n     placeholder so the copy renders verbatim. */\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionOverlay--gTZxS {\n  position: absolute;\n  inset: 0;\n  z-index: 9;\n  pointer-events: none;\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3 {\n  appearance: none;\n  position: absolute;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  padding: 0;\n  border: 0;\n  border-radius: 4px;\n  background: transparent;\n  color: var(--color-icon-secondary, #666);\n  cursor: pointer;\n  opacity: 0;\n  pointer-events: none;\n  transition:\n    opacity 120ms ease,\n    background-color 120ms ease,\n    color 120ms ease;\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3::before {\n  content: '';\n  display: block;\n  width: 6px;\n  height: 6px;\n  border-color: currentColor;\n  border-style: solid;\n  border-width: 0 1.5px 1.5px 0;\n  transform: translateY(-1px) rotate(45deg);\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3[data-heading-collapsed='true']::before {\n  transform: translateX(-1px) rotate(-45deg);\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3[data-control-visible='true'],\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3:hover,\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3:focus-visible {\n  opacity: 1;\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3[data-control-visible='true'] {\n  pointer-events: auto;\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3:hover,\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3:focus-visible {\n  background: var(--color-bg-secondary, #f5f5f5);\n  color: var(--color-icon, #1a1a1a);\n}\n\n.figspec_editor_theme--collapsibleHeadingRegionControl--VIya3:focus-visible {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 1px;\n}\n\n@media screen {\n  .figspec_editor_theme--contentEditable--nSwCZ [data-figspec-heading-region-hidden='true'] {\n    display: none !important;\n  }\n}\n\n/* Code blocks */\n\n.figspec_editor_theme--code--Ua5Hk {\n  display: block;\n  position: relative;\n  background-color: var(--color-bg-secondary, #f5f5f5);\n  border: 1px solid var(--color-border, #e5e5e5);\n  border-radius: var(--spacer-2, 8px);\n  padding: var(--spacer-3, 16px);\n  margin: var(--spacer-2-5, 12px) 0;\n  font-family: 'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', 'Courier New', monospace;\n  font-size: 13px;\n  line-height: 1.65;\n  color: var(--color-code, var(--color-text, #1a1a1a));\n  overflow-x: auto;\n  white-space: pre-wrap;\n  word-break: break-word;\n  tab-size: 2;\n}\n\n.figspec_editor_theme--codeHighlightComment--MraHW {\n  color: var(--color-codecomment, var(--color-text-tertiary, #999));\n}\n\n.figspec_editor_theme--codeHighlightKeyword--TODYU {\n  color: var(--color-codeaccent, #7d41cc);\n}\n\n.figspec_editor_theme--codeHighlightString--o-eZH {\n  color: var(--color-codestring, #238a46);\n}\n\n.figspec_editor_theme--codeHighlightProperty--yQ1xF {\n  color: var(--color-codeproperty, #a05a00);\n}\n\n.figspec_editor_theme--codeHighlightValue--rBh6h {\n  color: var(--color-codevalue, #a35c00);\n}\n\n.figspec_editor_theme--codeHighlightFunction--Jey22 {\n  color: var(--color-codeaccent, #7d41cc);\n}\n\n.figspec_editor_theme--codeHighlightTag--QAOjx {\n  color: var(--color-codetag, #c4382b);\n}\n\n.figspec_editor_theme--codeHighlightAttribute--UoELa {\n  color: var(--color-codeattribute, var(--color-codeproperty, #a05a00));\n}\n\n.figspec_editor_theme--codeHighlightClassName--FnvFx {\n  color: var(--color-codeclassname, #0a6cff);\n}\n\n.figspec_editor_theme--codeHighlightVariable--Yy51r {\n  color: var(--color-codevariable, #c4382b);\n}\n\n.figspec_editor_theme--codeHighlightPunctuation--SkEyv {\n  color: var(--color-text-secondary, #666);\n}\n\n.figspec_editor_theme--codeHighlightInserted--7CUUg {\n  color: var(--color-text-success, #238a46);\n}\n\n.figspec_editor_theme--codeHighlightDeleted--r4IGI {\n  color: var(--color-text-danger, #d92d20);\n}\n\n/* Code language badge. A pseudo-element, not a DOM child, so it stays out of\n   Lexical's reconciled children \u2014 see FigspecCodeNode for why that matters. */\n\n.figspec_editor_theme--code--Ua5Hk[data-language]:not([data-language=''])::after {\n  content: attr(data-language);\n  position: absolute;\n  top: var(--spacer-2, 8px);\n  right: var(--spacer-2-5, 12px);\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--color-text-tertiary, #999);\n  background-color: var(--color-bg-tertiary, #ebebeb);\n  padding: 2px var(--spacer-2, 8px);\n  border-radius: 4px;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  text-transform: lowercase;\n  pointer-events: none;\n  -webkit-user-select: none;\n          user-select: none;\n}\n\n/* Block quotes \u2014 italic is applied via the ITALIC text-format bit on child\n   TextNodes, not via CSS, so the toolbar's italic button reflects state and\n   can toggle italic off. See BlockquoteShortcutPlugin. */\n\n.figspec_editor_theme--quote--kU6ij {\n  border-left: 3px solid var(--color-border-brand, var(--color-bg-brand, #9747ff));\n  padding: var(--spacer-1, 4px) 0 var(--spacer-1, 4px) 20px;\n  margin: var(--spacer-2-5, 12px) 0;\n  color: var(--color-text-secondary, #666);\n  line-height: 1.6;\n}\n\n.figspec_editor_theme--blockquote---jyjg {\n  position: relative;\n  display: block;\n  border-left: 3px solid var(--color-border-brand, var(--color-bg-brand, #9747ff));\n  padding: var(--spacer-1, 4px) 0 var(--spacer-1, 4px) 20px;\n  margin: var(--spacer-2-5, 12px) 0;\n  color: var(--color-text-secondary, #666);\n  line-height: 1.6;\n  white-space: pre-wrap;\n}\n\n/* List items render real marker elements from FigspecListItemNode. */\n\n.figspec_editor_theme--listItem--N5L4O {\n  position: relative;\n  min-height: 1.5em;\n  margin-left: calc(var(--spacer-6, 40px) * var(--figspec-indent, 0));\n}\n\n.figspec_editor_theme--listItemContent--vdc6o {\n  display: block;\n  min-height: inherit;\n  margin-left: var(--spacer-4, 24px);\n  margin-inline-start: var(--spacer-4, 24px);\n}\n\n.figspec_editor_theme--listItemMarker--RjVy0 {\n  position: absolute;\n  left: var(--spacer-1, 4px);\n  top: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--spacer-3, 16px);\n  /* Lock the marker's bounding box to the content's first line-box. With\n     `font-size: inherit` (the editor's 16px base) and `line-height: 1.6`,\n     `1.6em` resolves to 25.6px, identical to `.listItemContent`'s first\n     line-box. Combined with `top: 0` and `align-items: center`, this puts\n     the marker's vertical center exactly on the first line's vertical\n     center \u2014 so any glyph centered inside the marker is aligned with the\n     first line of text. The visual glyph size is set on `.listItemMarkerGlyph`\n     instead of here so subclasses can scale the glyph without resizing the\n     marker box (which would re-introduce a misalignment offset). */\n  height: 1.6em;\n  color: var(--color-text, #1a1a1a);\n  font-size: inherit;\n  line-height: inherit;\n  -webkit-user-select: none;\n          user-select: none;\n  pointer-events: none;\n}\n\n/* Inner glyph span for ordered/unordered markers. `line-height: 1` keeps the\n   glyph's own line-box exactly its font-size, so a larger glyph (e.g. 18px \u2022)\n   doesn't inflate the parent marker's height past the content line-box and\n   re-introduce the alignment drift. The flex parent centers this child\n   vertically, which works correctly because the child's height matches its\n   font-size. */\n\n.figspec_editor_theme--listItemMarkerGlyph--rY-bb {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n}\n\n.figspec_editor_theme--listItemMarkerOrdered--lOZZl {\n  /* Anchor the marker's right edge `--spacer-1` (4px) before `.listItemContent`\n     starts (at 24px), giving a consistent gap between the ordinal's \".\" and\n     the item text. `width: auto` + `min-width` lets 10., 100., etc. grow\n     leftward instead of being clipped by a fixed width. `white-space: nowrap`\n     is load-bearing: without it the paragraph's `pre-wrap` is inherited and\n     \"10.\" wraps across two lines inside the 20px min-width box. */\n  left: auto;\n  right: calc(100% - 20px);\n  width: auto;\n  min-width: 20px;\n  white-space: nowrap;\n  justify-content: flex-end;\n  font-feature-settings: \"tnum\";\n  font-variant-numeric: tabular-nums;\n}\n\n.figspec_editor_theme--listItemMarkerOrdered--lOZZl .figspec_editor_theme--listItemMarkerGlyph--rY-bb {\n  /* Ordered markers grow leftward, so let the inner glyph span flow inline\n     instead of becoming a flex container that fights the right-anchored\n     parent. */\n  display: inline;\n}\n\n/* The disc glyph's metrics are smaller than the circle/square glyphs at the\n   same font-size, so it gets bumped up slightly to feel optically equivalent.\n   These are pure visual tuning values, not spacing/typography scale steps,\n   so they stay as raw px rather than being mapped to a spacer/text token. */\n\n.figspec_editor_theme--listItemMarkerUnorderedDisc--IJ8z5 .figspec_editor_theme--listItemMarkerGlyph--rY-bb {\n  font-size: 18px;\n}\n\n.figspec_editor_theme--listItemMarkerUnorderedCircle--sYeyK .figspec_editor_theme--listItemMarkerGlyph--rY-bb,\n.figspec_editor_theme--listItemMarkerUnorderedSquare--SEQmP .figspec_editor_theme--listItemMarkerGlyph--rY-bb {\n  font-size: 16px;\n}\n\n.figspec_editor_theme--listItemMarkerTodo--uL4zq {\n  /* Inherit position/top/height from `.listItemMarker` so the checkbox is\n     aligned within the first line's 1.5em box (matching bullets) instead of\n     being vertically centered across every wrapped line. The actual 16\xd716\n     checkbox visual is drawn by the nested `.listItemMarkerTodoBox`. */\n  border: none;\n  background: none;\n  padding: 0;\n  cursor: pointer;\n  pointer-events: auto;\n}\n\n.figspec_editor_theme--listItemMarkerTodoBox--RwRy3 {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--spacer-3, 16px);\n  height: var(--spacer-3, 16px);\n  min-height: var(--spacer-3, 16px);\n  border: 2px solid var(--color-text-secondary, #666);\n  border-radius: 3px;\n  box-sizing: border-box;\n  background: transparent;\n  color: var(--color-icon-onbrand, #fff);\n  line-height: 1;\n  font-size: 11px;\n}\n\n.figspec_editor_theme--listItemMarkerTodoChecked--pH6hP .figspec_editor_theme--listItemMarkerTodoBox--RwRy3 {\n  background-color: var(--color-bg-brand, #0d99ff);\n  border-color: var(--color-bg-brand, #0d99ff);\n}\n\n.figspec_editor_theme--listItemTodoChecked--luzox {\n  -webkit-text-decoration: line-through;\n  text-decoration: line-through;\n  color: var(--color-text-tertiary, #999);\n}\n\n/* Tables */\n\n/*\n * Notion-style table layout:\n *   - Cells use `table-layout: fixed` with explicit per-column widths\n *     persisted on the table node. Content wraps within the column width\n *     instead of expanding it. New tables get default widths summing to\n *     the editor column so they look \"filled\" on insert (see\n *     `table_operations.ts` + `share/figspec-markdown/src/import.ts`).\n *   - The wrapper is left-aligned at the editor column's left edge \u2014\n *     same anchor as paragraphs and headings, not centered.\n *   - When column widths sum past the editor column the wrapper extends\n *     visually into the right gutter (asymmetric version of the previous\n *     `gutter-spare` extension \u2014 left edge stays anchored). Past the right\n *     gutter it engages `overflow-x: auto` for internal horizontal scroll.\n *     The page itself is set to `overflow: hidden` app-wide (the\n *     `data-prevent-html-scroll` policy), so page-level horizontal scroll\n *     is not available and the wrapper has to own the overflow.\n *\n * `gutter-spare` = `max(0, 50vw - half-column - spacer)`. At viewports\n * narrower than the centered-column threshold the spare clamps to 0 and\n * the wrapper caps at the editor column, with internal scroll for any\n * wider table.\n */\n\n.figspec_editor_theme--tableScrollContainer--W-mSQ {\n  --table-gutter-spare: max(\n    0px,\n    calc(50vw - 360px - var(--spacer-4) - var(--figspec-layout-left-bias, 0px))\n  );\n  /* Visually extend the wrapper into BOTH gutters: shift the wrapper's\n     left edge into the left gutter with negative margin, then push the\n     table back to editor.left with equal padding. This way the wrapper\n     occupies the full editor-row visual band, and when internal scroll\n     engages, table cells that scroll off the left of the editor column\n     stay visible inside the left-gutter portion of the wrapper instead\n     of being clipped at editor.left. */\n  box-sizing: border-box;\n  width: max-content;\n  max-width: calc(100% + var(--table-gutter-spare) * 2);\n  /* Boundary-circle buttons render `BOUNDARY_BUTTON_GUTTER_PX` (18px) above\n     the table's top edge (and below the bottom). To keep them from\n     overlapping adjacent content \u2014 particularly the reserved scrollbar\n     gutter of a preceding/following table, but also the last line of a\n     preceding paragraph \u2014 the vertical margin must clear the button\n     gutter with a small visual buffer on top. */\n  margin-top: calc(var(--spacer-2-5, 12px) + 18px);\n  margin-bottom: calc(var(--spacer-2-5, 12px) + 18px);\n  margin-left: calc(var(--table-gutter-spare) * -1);\n  padding-left: var(--table-gutter-spare);\n  /* Reserve room below the table for the horizontal scrollbar even when\n     the table fits, so below-table content doesn't shift down when a\n     column resize crosses the overflow threshold. `scrollbar-gutter:\n     stable` would be the standards-track fix but currently only applies\n     to the inline (vertical scrollbar) axis in Chromium; a fixed\n     `padding-bottom` is the reliable cross-browser approach. Sized\n     generously to cover Windows/Linux classic scrollbars (typically\n     14\u201318px); on overlay-scrollbar systems (macOS) it's just a few px\n     of bottom breathing room. */\n  padding-bottom: 18px;\n  overflow-x: auto;\n  overflow-y: visible;\n}\n\n/* Inset box-shadow on the <tbody>, not an outline on the .tableScroll-\n * Container wrapper that holds the class: the wrapper has overflow-x: auto\n * capped at the editor column, so a wrapper outline hugs editor edges when\n * the table overflows. Outlines on inner elements get clipped too \u2014\n * overflow-x: auto coerces overflow-y to auto. */\n\n.figspec_editor_theme--tableSelected--260Bm > table > tbody {\n  box-shadow: inset 0 0 0 2px var(--color-bg-brand, #0d99ff);\n}\n\n/*\n * Applied to a single <td> when its cell node is the only entry in a\n * NodeSelection. Lands after triple-Cmd+A escalates from \"all text in\n * cell\" to \"cell as a unit\" \u2014 gives a clear visual that copy/cut/delete\n * will operate on the whole cell, not just its current text selection.\n * Inset outline so it doesn't bleed past the cell border into siblings.\n */\n\n.figspec_editor_theme--tableCellSelected---gaJG {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: -2px;\n}\n\n.figspec_editor_theme--table--w42w- {\n  display: table;\n  width: max-content;\n  border-collapse: collapse;\n  table-layout: fixed;\n  margin: 0;\n}\n\n.figspec_editor_theme--tableCell--kOUIy {\n  position: relative;\n  min-width: 150px;\n  padding: 8px 10px;\n  border: 1px solid var(--color-border, #e5e5e5);\n  vertical-align: top;\n  line-height: 1.5;\n  white-space: pre-wrap;\n  overflow: auto;\n  overflow-wrap: break-word;\n}\n\n.figspec_editor_theme--tableCellListContent--5v-7T {\n  display: block;\n  min-height: inherit;\n}\n\n.figspec_editor_theme--tableOverlay--asZRl {\n  position: absolute;\n  inset: 0;\n  z-index: 10;\n  pointer-events: none;\n}\n\n.figspec_editor_theme--tableAddButton--Gqqyj {\n  position: absolute;\n  width: 8px;\n  height: 8px;\n  padding: 0;\n  border: 2px solid var(--color-bg, #fff);\n  border-radius: 50%;\n  background: var(--color-bg-brand, #0d99ff);\n  color: var(--color-bg, #fff);\n  box-shadow: var(--elevation-100-canvas);\n  font-family: inherit;\n  font-size: 0;\n  line-height: 0;\n  cursor: pointer;\n  pointer-events: auto;\n  transform: translate(-50%, -50%);\n  transition:\n    width 80ms ease,\n    height 80ms ease,\n    background-color 80ms ease;\n}\n\n.figspec_editor_theme--tableAddButton--Gqqyj::before,\n.figspec_editor_theme--tableAddButton--Gqqyj::after {\n  content: '';\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  display: block;\n  width: 12px;\n  height: 2px;\n  border-radius: 1px;\n  background: currentColor;\n  opacity: 0;\n  transform: translate(-50%, -50%);\n}\n\n.figspec_editor_theme--tableAddButton--Gqqyj::after {\n  width: 2px;\n  height: 12px;\n}\n\n.figspec_editor_theme--tableAddButton--Gqqyj:hover,\n.figspec_editor_theme--tableAddButton--Gqqyj:focus-visible {\n  width: 22px;\n  height: 22px;\n  background: var(--color-bg-brand, #0d99ff);\n  outline: none;\n}\n\n.figspec_editor_theme--tableSelectButton--ENcLM {\n  position: absolute;\n  width: 11px;\n  height: 11px;\n  padding: 0;\n  border: 2px solid var(--color-bg, #fff);\n  border-radius: 3px;\n  background: var(--color-bg-brand, #0d99ff);\n  box-shadow: var(--elevation-100-canvas);\n  cursor: pointer;\n  pointer-events: auto;\n  transform: translate(-50%, -50%);\n}\n\n.figspec_editor_theme--tableSelectButton--ENcLM:hover,\n.figspec_editor_theme--tableSelectButton--ENcLM:focus-visible {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 2px;\n}\n\n.figspec_editor_theme--tableAddButton--Gqqyj:hover::before,\n.figspec_editor_theme--tableAddButton--Gqqyj:hover::after,\n.figspec_editor_theme--tableAddButton--Gqqyj:focus-visible::before,\n.figspec_editor_theme--tableAddButton--Gqqyj:focus-visible::after {\n  opacity: 1;\n}\n\n.figspec_editor_theme--tableContextMenu--NDXBp {\n  position: absolute;\n  z-index: 11;\n  min-width: 164px;\n  padding: 4px;\n  border: 1px solid var(--color-border, #e5e5e5);\n  border-radius: 6px;\n  background: var(--color-bg, #fff);\n  box-shadow: var(--elevation-400-menu-panel);\n  pointer-events: auto;\n}\n\n.figspec_editor_theme--tableContextMenuItem--eECWj {\n  display: block;\n  width: 100%;\n  padding: 6px 8px;\n  border: 0;\n  border-radius: 4px;\n  background: transparent;\n  color: var(--color-text, #1a1a1a);\n  font: inherit;\n  font-size: 12px;\n  line-height: 16px;\n  text-align: left;\n  cursor: pointer;\n}\n\n.figspec_editor_theme--tableContextMenuItem--eECWj:hover:not(:disabled),\n.figspec_editor_theme--tableContextMenuItem--eECWj:focus-visible:not(:disabled) {\n  background: var(--color-bg-secondary, #f5f5f5);\n  outline: none;\n}\n\n.figspec_editor_theme--tableContextMenuItem--eECWj:disabled {\n  color: var(--color-text-disabled, #b3b3b3);\n  cursor: default;\n}\n\n.figspec_editor_theme--tableContextMenuSeparator--CUqyl {\n  height: 1px;\n  margin: 4px;\n  background: var(--color-border, #e5e5e5);\n}\n\n/* Text styles */\n\n.figspec_editor_theme--textBold--GAzpA {\n  font-weight: 700;\n}\n\n.figspec_editor_theme--textItalic--s7kEe {\n  font-style: italic;\n}\n\n.figspec_editor_theme--textStrikethrough--clr5V {\n  -webkit-text-decoration: line-through;\n  text-decoration: line-through;\n}\n\n.figspec_editor_theme--textCode--DrCvh {\n  background-color: var(--color-bg-secondary, #f5f5f5);\n  border-radius: 3px;\n  padding: 1px 5px;\n  font-family: 'SF Mono', 'Fira Code', 'Roboto Mono', 'Courier New', monospace;\n  font-size: 0.9em;\n}\n\n/* Horizontal rule */\n\n.figspec_editor_theme--hrWrapper--Duo9D {\n  margin: var(--spacer-3, 16px) 0;\n}\n\n.figspec_editor_theme--hr--Pfjmj {\n  border: none;\n  border-top: 1px solid var(--color-border, #e5e5e5);\n  margin: 0;\n}\n\n.figspec_editor_theme--hrSelected--VF7R0 {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 4px;\n  border-radius: 1px;\n}\n\n/* Image block */\n\n.figspec_editor_theme--imageWrapper--AtJvo {\n  margin: var(--spacer-3, 16px) 0;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n}\n\n.figspec_editor_theme--imageFigure--hSA0Z {\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  /* Floor keeps a deliberately small image (e.g. 60px-wide icon)\n     from collapsing the caption into a tower of wrapped text under a\n     thumbnail. The frame stays left-anchored within the floored figure;\n     the caption is sized inline from the rendered frame so it can stay\n     visually centered under the image. Larger images grow past the floor\n     naturally. */\n  align-items: flex-start;\n  width: fit-content;\n  /* START KEEP_IN_SYNC_SECTION(imageFigureMinWidth) */\n  /* KEEP_IN_SYNC(web/js/figspec/editor/image_block_component.tsx#FIGSPEC_IMAGE_CAPTION_MIN_WIDTH_PX) */\n  min-width: min(240px, 100%);\n  /* END KEEP_IN_SYNC_SECTION */\n  max-width: 100%;\n}\n\n.figspec_editor_theme--imageImg--rxosR {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: var(--spacer-1, 4px);\n}\n\n.figspec_editor_theme--imageImgLetterboxed--8w0aE {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.figspec_editor_theme--imageImgPending--UGV2w {\n  opacity: 0.72;\n}\n\n.figspec_editor_theme--imageSelected--ZlW-h {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 2px;\n  border-radius: 1px;\n}\n\n.figspec_editor_theme--imageFrame--TTlDx {\n  position: relative;\n  display: block;\n  width: fit-content;\n  max-width: 100%;\n  /* Establish a fresh stacking context so the absolutely-positioned overlay\n     children below don't escape this block. */\n  isolation: isolate;\n}\n\n.figspec_editor_theme--imageStatusOverlay--tttfR {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacer-1-5, 6px);\n  padding: var(--spacer-1-5, 6px) var(--spacer-2, 8px);\n  border-radius: 999px;\n  /* stylelint-disable-next-line @figma/color-no-raw */\n  background: rgb(0 0 0 / 0.68);\n  color: var(--color-text-oninverse, #fff);\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 1;\n  pointer-events: none;\n  white-space: nowrap;\n}\n\n.figspec_editor_theme--imageStatusOverlayError--m4Br2 {\n  /* stylelint-disable-next-line @figma/color-no-raw */\n  background: rgb(195 53 35 / 0.92);\n}\n\n.figspec_editor_theme--imageUploadingIndicator--O3cH9 {\n  position: absolute;\n  z-index: 2;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n}\n\n.figspec_editor_theme--imageReplaceButton--q7zQJ {\n  /* The backdrop is an intentionally fixed dark translucent disc that sits\n     over an arbitrary user image, so the icon needs to stay white in both\n     light and dark mode. `--color-text-oninverse` flips to dark in dark\n     mode (its semantic is \"text on an inverse-themed background\"), which\n     painted a near-black icon on a near-black backdrop. `*-onmeasure` is\n     the \"always white\" semantic for content on a fixed-dark surface. */\n  --color-icon: var(--color-icon-onmeasure, #fff);\n  --fpl-icon-color: var(--color-icon-onmeasure, #fff);\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  position: absolute;\n  z-index: 2;\n  right: var(--spacer-2, 8px);\n  bottom: var(--spacer-2, 8px);\n  width: 28px;\n  height: 28px;\n  padding: 0;\n  border: none;\n  border-radius: 999px;\n  /* stylelint-disable-next-line @figma/color-no-raw */\n  background: rgb(0 0 0 / 0.55);\n  color: var(--color-text-onmeasure, #fff);\n  cursor: pointer;\n  opacity: 0.82;\n  -webkit-backdrop-filter: blur(4px);\n          backdrop-filter: blur(4px);\n  transition:\n    opacity 120ms ease,\n    background-color 120ms ease,\n    transform 120ms ease;\n}\n\n.figspec_editor_theme--imageReplaceButton--q7zQJ:hover:not(:disabled),\n.figspec_editor_theme--imageReplaceButton--q7zQJ:focus-visible:not(:disabled) {\n  /* stylelint-disable-next-line @figma/color-no-raw */\n  background: rgb(0 0 0 / 0.72);\n  opacity: 1;\n  transform: translateY(-1px);\n}\n\n.figspec_editor_theme--imageReplaceButton--q7zQJ:focus-visible {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 2px;\n}\n\n.figspec_editor_theme--imageReplaceButton--q7zQJ:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.figspec_editor_theme--imageReplaceIcon--7h-UW {\n  width: 16px;\n  height: 16px;\n}\n\n/* Draggable-for-reorder modifier on the image frame. The frame itself is\n   the drag affordance \u2014 pointerdown anywhere on it (outside its sub-\n   controls) starts a reorder drag. The grab cursor signals this; during\n   an active drag we pin `cursor: grabbing` on document.body inline. */\n\n.figspec_editor_theme--imageFrameDraggable--UUV5b {\n  cursor: grab;\n}\n\n/* Half-opacity on the source frame while a reorder drag is active so the\n   user can see at a glance which block is mid-move \u2014 the drop indicator\n   on its own makes the *destination* legible but doesn't visually mark\n   the *source*. */\n\n.figspec_editor_theme--imageFrameDragging--SuA-D {\n  opacity: 0.5;\n}\n\n/* Horizontal drop indicator rendered via portal during a reorder drag.\n   Position and horizontal extent are supplied inline (top: viewport Y;\n   left + width: editor root's viewport rect) so the line is constrained\n   to the document column rather than spanning the full viewport. */\n\n.figspec_editor_theme--imageReorderDropIndicator--lF7OT {\n  position: fixed;\n  height: 2px;\n  background: var(--color-bg-brand, #0d99ff);\n  pointer-events: none;\n  z-index: 9999;\n  transform: translateY(-1px);\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-bg) 50%, transparent);\n}\n\n/* Mirrors Figma's canvas convention (FGEditShapeBehavior): a small square\n   with a white fill and 2px brand-blue border, centered on the selection\n   outline corner. The selection outline is 2px wide at outline-offset 2px,\n   so its centerline sits 3px outside the image edge. With border-box\n   sizing (global default), `width: 8px` is the total visible size, so a\n   -7px corner offset puts the handle's center exactly on the outline\n   centerline (-7 + 8/2 = -3 from parent edge \u2192 +3 outside the image). */\n\n.figspec_editor_theme--imageResizeHandle--1T0F5 {\n  appearance: none;\n  position: absolute;\n  z-index: 3;\n  width: 8px;\n  height: 8px;\n  padding: 0;\n  border-radius: 1px;\n  border: 2px solid var(--color-bg-brand, #0d99ff);\n  /* `--color-icon-onbrand` is consistently white across light/dark modes,\n     matching the canvas convention (and C++ `colors().iconOnbrand`).\n     `--color-bg` would flip dark in dark mode; `--color-border-onbrand`\n     resolves to a brand-blue tint \u2014 neither is what we want here. */\n  background: var(--color-icon-onbrand, #fff);\n  pointer-events: auto;\n  /* Subtle drop shadow so the handle reads against busy image content. */\n  box-shadow: 0 0 1px color-mix(in srgb, var(--color-text) 40%, transparent);\n}\n\n.figspec_editor_theme--imageResizeHandleNw--1UZDv {\n  top: -7px;\n  left: -7px;\n  cursor: nwse-resize;\n}\n\n.figspec_editor_theme--imageResizeHandleNe--KIJNf {\n  top: -7px;\n  right: -7px;\n  cursor: nesw-resize;\n}\n\n.figspec_editor_theme--imageResizeHandleSw--xhw80 {\n  bottom: -7px;\n  left: -7px;\n  cursor: nesw-resize;\n}\n\n.figspec_editor_theme--imageResizeHandleSe--c72x0 {\n  bottom: -7px;\n  right: -7px;\n  cursor: nwse-resize;\n}\n\n.figspec_editor_theme--imageAltEditor--gv1xX {\n  /* Sits below the image frame as a sibling \u2014 no fill, no absolute\n     positioning. Reads as a caption on the document background rather\n     than an overlay control on top of the picture. The textarea sizes\n     to its content via `rows`, so no max-height/overflow scrollbar \u2014\n     a caption is meant to be read, not scrolled inside.\n\n     `max-width: 100%` clamps the inline `width: <px>` that\n     `computeAltEditorStyle` sets when the rendered frame exceeds the\n     document column (or the viewport is narrower than the 240px floor),\n     so the centered caption text can't anchor off the side of the\n     containing figure. */\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  margin-top: var(--spacer-1, 4px);\n  min-height: 20px;\n  padding: 0;\n  box-sizing: border-box;\n  border: none;\n  background: transparent;\n  color: var(--color-text-secondary, #666);\n  font: inherit;\n  font-size: 13px;\n  line-height: 1.5;\n  text-align: center;\n  resize: none;\n  overflow: hidden;\n}\n\n.figspec_editor_theme--imageAltEditor--gv1xX:focus-visible {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 2px;\n  color: var(--color-text, #1a1a1a);\n}\n\n.figspec_editor_theme--imageAltEditor--gv1xX::placeholder {\n  color: var(--color-text-secondary, #666);\n  font-style: italic;\n}\n\n.figspec_editor_theme--imagePlaceholder--8cHKO {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacer-2-5, 12px);\n  padding: var(--spacer-6, 40px) var(--spacer-4, 24px);\n  border: 2px dashed var(--color-border, #e5e5e5);\n  border-radius: var(--spacer-2, 8px);\n  box-sizing: border-box;\n  background-color: var(--color-bg-secondary, #f5f5f5);\n  aspect-ratio: var(--figspec-image-aspect, auto);\n  min-height: 80px;\n}\n\n.figspec_editor_theme--imagePlaceholderActionable--ZXL04 {\n  cursor: pointer;\n  transition:\n    background-color 120ms ease,\n    border-color 120ms ease;\n}\n\n.figspec_editor_theme--imagePlaceholderActionable--ZXL04:hover,\n.figspec_editor_theme--imagePlaceholderActionable--ZXL04:focus-visible {\n  border-color: var(--color-border-strong, #b3b3b3);\n  background-color: var(--color-bg-hover, #f0f0f0);\n}\n\n.figspec_editor_theme--imagePlaceholderActionable--ZXL04:focus-visible {\n  outline: 2px solid var(--color-bg-brand, #0d99ff);\n  outline-offset: 2px;\n}\n\n.figspec_editor_theme--imageIcon--t-fas {\n  color: var(--color-text-tertiary, #999);\n}\n\n.figspec_editor_theme--imageLightboxBackdrop--9QYOq {\n  --image-lightbox-padding: 48px;\n  --image-lightbox-gutter: calc(var(--image-lightbox-padding) + var(--image-lightbox-padding));\n  --image-lightbox-zoom-scale: 1.5;\n  position: fixed;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100vw;\n  height: 100vh;\n  max-width: none;\n  max-height: none;\n  margin: 0;\n  padding: var(--image-lightbox-padding);\n  box-sizing: border-box;\n  border: none;\n  /* stylelint-disable-next-line @figma/color-no-raw */\n  background: rgb(0 0 0 / 0.88);\n}\n\n.figspec_editor_theme--imageLightboxBackdropButton--l1bPE {\n  appearance: none;\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  width: 100%;\n  height: 100%;\n  padding: 0;\n  border: none;\n  background: transparent;\n  cursor: default;\n}\n\n.figspec_editor_theme--imageLightboxImageZoomButton--zTllM {\n  appearance: none;\n  position: relative;\n