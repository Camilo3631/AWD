// orange rectangles on the current page.

figma.showUI(__html__, { width: 240, height: 120 });

figma.ui.onmessage = (msg) => {
  if (msg.type === 'create-shapes') {
    const numberOfRectangles = msg.count;
    const nodes = [];
    for (let i = 0; i < numberOfRectangles; i++) {
      const rect = figma.createRectangle();
      rect.x = i * 150;
      rect.fills = [{ type: 'SOLID', color: { r: 1, g: 0.5, b: 0 } }];
      figma.currentPage.appendChild(rect);
      nodes.push(rect);
    }
    figma.currentPage.selection = nodes;
    figma.viewport.scrollAndZoomIntoView(nodes);
  }

  figma.closePlugin();
};
`,eO=`<!DOCTYPE html>
<html>
  <body style="font-family: sans-serif; padding: 12px;">
    <label for="count">Rectangles:</label>
    <input id="count" type="number" value="3" min="1" style="width: 60px;" />
    <button id="create" style="margin-left: 8px;">Create</button>
    <script>
      document.getElementById('create').onclick = () => {
        const count = parseInt(document.getElementById('count').value, 10) || 1;
        parent.postMessage({ pluginMessage: { type: 'create-shapes', count } }, '*');
      };
    </script>
  </body>
</html>
